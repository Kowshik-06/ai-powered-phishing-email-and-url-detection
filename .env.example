# Directory containing the trained URL model artifacts and optional dataset.csv.
# Defaults to ml-service. Set in the ML service process environment; this file
# is a documentation template and is not loaded automatically.
PHISHING_MODEL_DIR=

# Optional external reputation integration
# Leave blank for fully local operation.
VT_API_KEY=

# Set in the backend process environment before first-admin promotion.
ADMIN_SETUP_TOKEN=

# A critical alert requires a phishing verdict, score/confidence thresholds,
# low model disagreement, and at least one independent detection indicator.
CRITICAL_ALERT_MIN_SCORE=95
CRITICAL_ALERT_MIN_CONFIDENCE=70
HIGH_RISK_SCORE=70

# Optional hosted explanation provider (OpenAI-compatible chat completions).
# Disabled by default. The rule-based explanation works with these blank.
# The API key is read only by the backend process and is never sent to the browser.
# Remote providers must use https://. Plain http:// is accepted only for
# 127.0.0.1 or localhost (for example, a local model server).
# Only sanitized, already-verified findings are sent: no raw emails, attachment
# bytes, screenshot text, full URLs, credentials, or hashes.
EXPLAIN_AI_ENABLED=false
EXPLAIN_AI_BASE_URL=
EXPLAIN_AI_MODEL=
EXPLAIN_AI_API_KEY=
EXPLAIN_AI_TIMEOUT_MS=12000
EXPLAIN_AI_MAX_OUTPUT_CHARS=4000
